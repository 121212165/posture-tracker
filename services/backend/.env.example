# 数据库
POSTGRES_PASSWORD=please-change-this-password
DATABASE_URL=postgresql://postgres:please-change-this-password@localhost:5432/posture_tracker?schema=public

# JWT（生产环境务必使用强随机字符串，至少 32 位）
JWT_SECRET=please-generate-a-strong-random-secret

# 微信小程序（请填入你自己的 AppID 和 AppSecret）
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=posture-tracker
MINIO_SECURE=false

# AI 推理服务
AI_SERVICE_URL=http://localhost:8000

# H5 报告端
H5_BASE_URL=http://localhost:3001

# 服务端口
PORT=3000
