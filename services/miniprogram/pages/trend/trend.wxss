.member-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.member-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ec4899, #db2777);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.member-info {
  flex: 1;
}

.member-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.member-meta {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 指标切换 Tab */
.metric-tabs {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 0 24rpx;
}

.metric-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: 2rpx solid #e5e7eb;
}

.metric-tab.active {
  background: linear-gradient(135deg, #ec4899, #db2777);
  color: #ffffff;
  border-color: transparent;
}

/* 趋势图 */
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.chart-container {
  display: flex;
  height: 360rpx;
  padding: 24rpx 0;
}

.y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 80rpx;
  padding-right: 16rpx;
  text-align: right;
}

.y-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.chart-area {
  flex: 1;
  position: relative;
  border-left: 2rpx solid #e5e7eb;
  border-bottom: 2rpx solid #e5e7eb;
  margin-bottom: 40rpx;
}

.data-points {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.data-point {
  position: absolute;
  transform: translate(-50%, 50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ec4899;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx #ec4899;
}

.point-value {
  position: absolute;
  top: -36rpx;
  font-size: 20rpx;
  color: #1f2937;
  font-weight: 600;
}

.point-date {
  position: absolute;
  top: 24rpx;
  font-size: 18rpx;
  color: #9ca3af;
  white-space: nowrap;
}

/* 改善摘要 */
.improvement-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.improvement-row:last-child {
  border-bottom: none;
}

.improvement-label {
  font-size: 28rpx;
  color: #4b5563;
}

.improvement-value {
  font-size: 28rpx;
  font-weight: 600;
}

.improvement-value.positive {
  color: #10b981;
}

.improvement-value.negative {
  color: #ef4444;
}

.improvement-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 8rpx;
  font-weight: 400;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 24rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: #e5e7eb;
}

.timeline-item {
  position: relative;
  padding: 12rpx 0 24rpx 24rpx;
}

.timeline-dot {
  position: absolute;
  left: -16rpx;
  top: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ec4899;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx #ec4899;
}

.timeline-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.timeline-date {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.timeline-type {
  font-size: 22rpx;
  color: #9ca3af;
}

.timeline-score {
  font-size: 24rpx;
  color: #ec4899;
  font-weight: 600;
}

.empty-chart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
}
