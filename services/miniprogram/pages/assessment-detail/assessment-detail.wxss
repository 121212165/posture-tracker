.status-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.status-COMPLETED {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
}

.status-PROCESSING {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
}

.status-FAILED {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
}

.status-PENDING {
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
}

.status-icon {
  font-size: 56rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
}

.status-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.status-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #9ca3af;
  font-size: 26rpx;
}

.info-value {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 500;
}

.score-display {
  text-align: center;
  margin-bottom: 32rpx;
}

.score-big {
  font-size: 80rpx;
  font-weight: 700;
  color: #ec4899;
}

.score-unit {
  font-size: 28rpx;
  color: #9ca3af;
}

.metric-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.metric-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.metric-name {
  font-size: 26rpx;
  color: #6b7280;
}

.metric-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.action-section {
  margin-top: 32rpx;
}

.btn-primary {
  width: 100%;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
}
