<view class="container">
  <view class="profile-header">
    <image class="avatar" src="{{coach.avatarUrl || ''}}" mode="aspectFill" />
    <view class="profile-info">
      <text class="name">{{coach.name || '教练'}}</text>
      <text class="role">{{coach.role === 'OWNER' ? '工作室管理员' : '教练'}}</text>
    </view>
  </view>

  <view class="studio-card" wx:if="{{studio}}">
    <text class="studio-title">工作室信息</text>
    <view class="info-row">
      <text class="label">名称</text>
      <text class="value">{{studio.name}}</text>
    </view>
    <view class="info-row">
      <text class="label">套餐</text>
      <text class="value">{{studio.plan === 'FREE' ? '免费版' : studio.plan === 'PRO' ? '专业版' : '企业版'}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item">
      <text class="menu-icon">📋</text>
      <text class="menu-text">使用指南</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">💬</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="btn-logout" bindtap="handleLogout">退出登录</button>
</view>
