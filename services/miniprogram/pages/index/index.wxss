.welcome-card {
  background: linear-gradient(135deg, #ec4899, #db2777);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.welcome-text {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.studio-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ec4899;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.action-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.action-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.action-info {
  flex: 1;
}

.action-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.arrow {
  font-size: 40rpx;
  color: #d1d5db;
}

.recent-section {
  margin-top: 40rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 12rpx;
}

.recent-info {
  flex: 1;
}

.recent-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.recent-date {
  font-size: 22rpx;
  color: #9ca3af;
}

.recent-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #ec4899;
}

.score-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-PROCESSING {
  background: #fef3c7;
  color: #92400e;
}

.status-PENDING {
  background: #e0e7ff;
  color: #3730a3;
}

.status-FAILED {
  background: #fee2e2;
  color: #991b1b;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #d1d5db;
}
