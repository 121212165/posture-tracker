.report-card {
  background: linear-gradient(135deg, #ec4899, #db2777);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.report-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.report-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 32rpx;
}

.qr-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.qr-code {
  width: 360rpx;
  height: 360rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
}

.qr-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 12rpx;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-outline {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
}

.btn-outline::after {
  border: none;
}

.btn-primary {
  flex: 1;
  background: #ffffff;
  color: #ec4899;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary::after {
  border: none;
}

.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.info-value {
  font-size: 26rpx;
  color: #1f2937;
  word-break: break-all;
}

.link {
  color: #ec4899;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
}
