# Backend
NODE_ENV=development
POSTGRES_PASSWORD=please-change-this-password
DATABASE_URL=postgresql://postgres:please-change-this-password@localhost:5432/posture_tracker
JWT_SECRET=please-generate-a-strong-random-secret
PORT=3000

# MinIO（root 凭证用于 minio 服务初始化和 backend 访问，生产请改为强密码）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=please-change-minio-password
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=please-change-minio-password
MINIO_SECURE=false
MINIO_BUCKET=posture-tracker

# AI Service
AI_SERVICE_URL=http://localhost:8000

# WeChat Mini Program（请填入你自己的 AppID 和 AppSecret）
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# Web Report
WEB_REPORT_URL=http://localhost:3001

# Python AI
PYTHONUNBUFFERED=1
